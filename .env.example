# Engineering Intelligence System (EIS) - Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control (only commit .env.example)

# ============================================================================
# Application Settings
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application name and version
APP_NAME=Engineering Intelligence System
APP_VERSION=0.1.0

# ============================================================================
# API Configuration
# ============================================================================

# API host (0.0.0.0 for Docker, localhost for dev)
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API title for documentation
API_TITLE=Engineering Intelligence System API

# CORS allowed origins (JSON array; CSV is also accepted)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ============================================================================
# Qdrant Vector Store Configuration
# ============================================================================

# Qdrant URL
# Local Docker: http://qdrant:6333
# Local machine: http://localhost:6333
# Qdrant Cloud: https://your-cluster.qdrant.io
QDRANT_URL=http://qdrant:6333

# Qdrant API key (leave empty for local, required for Qdrant Cloud)
QDRANT_API_KEY=

# Qdrant connection timeout (seconds)
QDRANT_TIMEOUT=30

# ============================================================================
# Embeddings Configuration
# ============================================================================

# Embeddings model
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDINGS_MODEL=text-embedding-3-small

# Embeddings dimension
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
# text-embedding-ada-002: 1536
EMBEDDINGS_DIMENSION=1536

# Embeddings batch size
EMBEDDINGS_BATCH_SIZE=100

# ============================================================================
# LLM Configuration
# ============================================================================

# LLM provider: anthropic, openai
LLM_PROVIDER=anthropic

# LLM model
LLM_MODEL=claude-3-sonnet-20240229

# Anthropic API key (required if using anthropic provider)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-

# OpenAI API key (required if using openai provider)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LLM temperature (0.0-2.0, lower = more deterministic)
LLM_TEMPERATURE=0.7

# LLM max tokens
LLM_MAX_TOKENS=2048

# ============================================================================
# Chunking Configuration
# ============================================================================

# Chunk size (tokens, approximate)
CHUNK_SIZE=1000

# Chunk overlap (ensures context continuity)
CHUNK_OVERLAP=200

# Minimum chunk size (skip if smaller)
MIN_CHUNK_SIZE=100

# ============================================================================
# Git Repository Ingestion
# ============================================================================

# Maximum file size to ingest (bytes, ~1MB)
MAX_FILE_SIZE=1048576

# Maximum repository clone time (seconds)
MAX_CLONE_TIME=300

# Clone strategy: shallow (faster), full (complete history)
GIT_CLONE_STRATEGY=shallow

# Git branch to clone
GIT_BRANCH=main

# ============================================================================
# GitHub API Configuration
# ============================================================================

# GitHub personal access token (for higher rate limits)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub API timeout (seconds)
GITHUB_TIMEOUT=30

# Include PR comments in ingestion (true/false)
GITHUB_INCLUDE_COMMENTS=true

# ============================================================================
# Search Configuration
# ============================================================================

# Vector search similarity threshold (0.0-1.0)
SEARCH_SIMILARITY_THRESHOLD=0.7

# Maximum search results
SEARCH_MAX_RESULTS=10

# Search timeout (seconds)
SEARCH_TIMEOUT=30

# ============================================================================
# Cache Configuration
# ============================================================================

# Enable caching (true/false)
ENABLE_CACHE=true

# Cache TTL (seconds)
CACHE_TTL=3600

# Cache backend: memory, redis
CACHE_BACKEND=memory

# Redis URL (required if CACHE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Database Configuration (Future Use)
# ============================================================================

# PostgreSQL database URL
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://eis:password@localhost:5432/eis

# ============================================================================
# Monitoring & Observability
# ============================================================================

# OpenTelemetry enabled (true/false)
ENABLE_TELEMETRY=false

# OpenTelemetry exporter type: jaeger, datadog, console
TELEMETRY_EXPORTER=console

# Jaeger endpoint (if using Jaeger)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# Security
# ============================================================================

# API key for authentication (set a strong random string)
API_SECRET_KEY=your-secret-key-change-in-production

# JWT secret key (for token-based auth)
JWT_SECRET=your-jwt-secret-change-in-production

# JWT expiration (hours)
JWT_EXPIRATION=24

# ============================================================================
# File Paths (Docker: /app/xxx)
# ============================================================================

# Data directory
DATA_DIR=/app/data

# Output directory for exports
OUTPUT_DIR=/app/output

# Logs directory
LOG_DIR=/app/logs

# Temporary directory
TEMP_DIR=/tmp

# ============================================================================
# Feature Flags
# ============================================================================

# Enable parallel ingestion (true/false)
ENABLE_PARALLEL_INGESTION=false

# Enable async processing (true/false)
ENABLE_ASYNC=false

# Enable request caching (true/false)
ENABLE_REQUEST_CACHE=true

# ============================================================================
# Development Settings
# ============================================================================

# Reload server on code changes (dev only)
RELOAD=true

# Include example data (dev only)
INCLUDE_EXAMPLES=false

# Enable debug endpoints (dev only, e.g., /debug/stats)
ENABLE_DEBUG_ENDPOINTS=false
